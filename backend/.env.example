PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/fintrack.sqlite
FRONTEND_ORIGIN=http://localhost:4200

# Generate with openssl rand -hex 48
JWT_SECRET=
DEMO_MODE=false

# Seed only: never reuse this password outside the fictional demo account.
DEMO_EMAIL=demo@fintrack.local
DEMO_PASSWORD=FinTrackDemo!2026
LOG_LEVEL=info


MFA_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=replace-with-your-google-app-password
MAIL_DELIVERY=outbox
MAIL_FROM=FinTrack <your-account@gmail.com>
GOOGLE_CLIENT_ID=

# Render Free: use the HTTPS API instead of SMTP ports 465/587.
# Set MAIL_DELIVERY=resend and MAIL_FROM to an address on your verified domain.
# Add the real key only to Render environment settings, never to Git or the frontend.
RESEND_API_KEY=
