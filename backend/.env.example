# Local development; copy to .env and keep real values outside Git.
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_PATH=./data/fintrack.sqlite
# Supabase PostgreSQL pooler URI: set privately in Render; takes precedence over SQLite.
DATABASE_URL=
# Optional path to the database CA certificate, when required by your provider.
DATABASE_CA_FILE=
FRONTEND_ORIGIN=http://localhost:4200
# Generate each secret separately with: openssl rand -hex 48
JWT_SECRET=
MFA_HMAC_SECRET=
DEMO_MODE=false
SEED_DEMO_ON_START=false
DEMO_EMAIL=demo@fintrack.local
DEMO_PASSWORD=FinTrackDemo!2026
LOG_LEVEL=info
# Local email files contain sensitive single-use links. Never publish data/outbox.
MAIL_DELIVERY=outbox
MAIL_OUTBOX_PATH=./data/outbox
MAIL_FROM=FinTrack <no-reply@example.com>
# Render Free: MAIL_DELIVERY=resend; configure these only in backend environment settings.
RESEND_API_KEY=
# SMTP is optional on hosts that allow outbound SMTP, not Render Free.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
