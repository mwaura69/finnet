  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PortfolioInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "clientName",
          "baseCurrency"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "clientName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "baseCurrency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ]
          }
        }
      },
      "TransactionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument",
          "type",
          "quantity",
          "unitPrice",
          "tradeDate"
        ],
        "properties": {
          "instrument": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.-]{0,19}$",
            "example": "SCOM"
          },
          "type": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000.0
          },
          "unitPrice": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000.0,
            "multipleOf": 0.01
          },
          "tradeDate": {
            "type": "string",
            "format": "date",
            "description": "A real date, on or before today (UTC)."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Portfolio": {
        "type": "object",
        "required": [
          "name",
          "clientName",
          "baseCurrency",
          "id",
          "createdAt",
          "totalValue",
          "totalInvested",
          "unrealizedGain",
          "holdingsCount",
          "transactionCount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "clientName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "baseCurrency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ]
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalValue": {
            "type": "number"
          },
          "totalInvested": {
            "type": "number"
          },
          "unrealizedGain": {
            "type": "number"
          },
          "holdingsCount": {
            "type": "integer"
          },
          "transactionCount": {
            "type": "integer"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "required": [
          "instrument",
          "type",
          "quantity",
          "unitPrice",
          "tradeDate",
          "id",
          "createdAt"
        ],
        "properties": {
          "instrument": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.-]{0,19}$",
            "example": "SCOM"
          },
          "type": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000.0
          },
          "unitPrice": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000.0,
            "multipleOf": 0.01
          },
          "tradeDate": {
            "type": "string",
            "format": "date",
            "description": "A real date, on or before today (UTC)."
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Holding": {
        "type": "object",
        "required": [
          "instrument",
          "netQuantity",
          "averageCost",
          "totalInvested",
          "unitPrice",
          "totalValue",
          "unrealizedGain"
        ],
        "properties": {
          "instrument": {
            "type": "string"
          },
          "netQuantity": {
            "type": "number"
          },
          "averageCost": {
            "type": "number"
          },
          "totalInvested": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number"
          },
          "totalValue": {
            "type": "number"
          },
          "unrealizedGain": {
            "type": "number"
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "holdings",
          "totalInvested",
          "totalValue",
          "unrealizedGain",
          "realizedGain",
          "valuationMethod"
        ],
        "properties": {
          "holdings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Holding"
            }
          },
          "totalInvested": {
            "type": "number"
          },
          "totalValue": {
            "type": "number"
          },
          "unrealizedGain": {
            "type": "number"
          },
          "realizedGain": {
            "type": "number"
          },
          "valuationMethod": {
            "type": "string",
            "enum": [
              "latest-transaction-price"
            ]
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "token",
          "user",
          "demoMode"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "demoMode": {
            "type": "boolean"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "user",
          "demoMode"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "demoMode": {
            "type": "boolean"
          }
        }
      }
    }
  }
