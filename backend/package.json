{
  "name": "@fintrack/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "dev:demo": "DEMO_MODE=true nodemon --config nodemon.json",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "db:setup": "tsx src/db/seeds/index.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "nodemon": "^3.1.10",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0"
  }
}
